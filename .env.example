# Primary Remote Database Credentials
DB_HOST=hostIp
DB_USER=username
DB_PASS=password
DB_NAME=database_name
DB_PORT=3306
DB_CHARSET=utf8mb4

# Secondary Local Fallback Credentials
DB_FALLBACK_HOST=localhost
DB_FALLBACK_USER=
DB_FALLBACK_PASS=
DB_FALLBACK_NAME=database_name
DB_FALLBACK_PORT=3306
# Application & Database Timezone Configuration (GMT +05:30 / IST)
APP_TIMEZONE=Asia/Kolkata
DB_TIMEZONE=+05:30